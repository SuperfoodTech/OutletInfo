# Browser headless mode (true = background tanpa GUI, false = tampilkan browser window)
HEADLESS=true
HEADLESS_GOFOOD=true
HEADLESS_GRAB=true
HEADLESS_SHOPEE=true

# Google Apps Script Web App URL untuk integrasi upload ke Google Drive
APP_SCRIPT_URL="https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec"

# ─── Bot 1: Bot Listing (/listing & /generate ke Google Drive) ─────────────────
DISCORD_BOT_TOKEN_LISTING=""
DISCORD_CHANNEL_ID_LISTING=""
# Fallback token & channel jika DISCORD_BOT_TOKEN_LISTING kosong
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""

# ─── Bot 2: Bot SOT (/sot & /status_sot ke Tab 'SOT' Google Sheet) ─────────────
DISCORD_BOT_TOKEN_SOT=""
DISCORD_CHANNEL_ID_SOT=""
SOT_APP_SCRIPT_URL="https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec"
GOOGLE_SHEET_DBR_URL=""
